@startuml
!define RECTANGLE class

' Define tables as classes
class Customers {
    + customer_id: int
    + first_name: string
    + last_name: string
    + email: string
    + phone: string
}

class Orders {
    + order_id: int
    + order_date: datetime
    + total_amount: decimal
    + customer_id: int
}

class Products {
    + product_id: int
    + name: string
    + price: decimal
    + category_id: int
}

class Categories {
    + category_id: int
    + category_name: string
}

class Payments {
    + payment_id: int
    + payment_date: datetime
    + order_id: int
    + amount: decimal
    + payment_method: string
}

' Relationships between tables
Customers "1" -- "0..*" Orders : places
Orders "1" -- "0..*" Products : contains
Products "1" -- "0..1" Categories : belongs to
Orders "1" -- "0..*" Payments : paid by

' Optional: Indicating foreign keys for clarity
Orders : customer_id
Products : category_id
Payments : order_id

@enduml
